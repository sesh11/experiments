# Copy this file to .env and fill in your key:  cp .env.example .env
# .env is gitignored — your real key never gets committed.

# Choose one provider. Anthropic remains the default.
#LLM_PROVIDER=anthropic

# REQUIRED when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# REQUIRED when LLM_PROVIDER=openrouter.
#OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Provider/model overrides. Bare Claude ids are accepted with OpenRouter and
# automatically become anthropic/<model>; other OpenRouter ids need a prefix.
#LLM_PROVIDER=openrouter
#MODEL_MAIN=anthropic/claude-sonnet-5
#MODEL_SIDEKICK=anthropic/claude-haiku-4-5
#JUDGE_PROVIDER=openrouter
#JUDGE_MODEL=openai/gpt-5

# Optional OpenRouter-compatible endpoint and app-attribution headers.
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENROUTER_SITE_URL=https://example.com
#OPENROUTER_APP_NAME=Opinionated Sidekicks

# OPTIONAL overrides (defaults shown). Uncomment to change.
# LIMIT is the number of SWE-bench instances; BUDGET is the global $ cap.
# These are also positional args: ./run_swebench.sh <LIMIT> <BUDGET>
#LIMIT=15
#BUDGET=25
