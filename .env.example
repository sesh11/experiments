# Copy this file to .env and fill in your key:  cp .env.example .env
# .env is gitignored — your real key never gets committed.

# REQUIRED: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPTIONAL: to run the `baseline-openrouter` variant, set an OpenRouter key
# (get one at https://openrouter.ai/keys). OPENROUTER_MODEL selects which model
# it routes to (default: anthropic/claude-sonnet-5, i.e. Sonnet 5 via OpenRouter
# for a parity check). Use any OpenRouter model slug, e.g. deepseek/deepseek-chat.
#OPENROUTER_API_KEY=sk-or-your-key-here
#OPENROUTER_MODEL=anthropic/claude-sonnet-5

# OPTIONAL overrides (defaults shown). Uncomment to change.
# LIMIT is the number of SWE-bench instances; BUDGET is the global $ cap.
# These are also positional args: ./run_swebench.sh <LIMIT> <BUDGET>
#LIMIT=15
#BUDGET=25
